<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="background" style="flex-grow: 1; opacity: 1; background-color: rgba(0, 0, 0, 0.5); justify-content: center; flex-direction: column; align-items: center;">
        <ui:VisualElement name="panel" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0.59); position: absolute; width: 25%; height: 25%; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;">
            <ui:VisualElement name="stats" style="flex-grow: 1; justify-content: center; align-items: center;">
                <ui:Label text="Score"/>
                <ui:Label text="123" name="score"/>
            </ui:VisualElement>
            <ui:VisualElement name="buttons" style="flex-grow: 0; justify-content: space-around; flex-direction: row; align-items: auto; align-self: stretch; margin-top: 16px; margin-right: 16px; margin-bottom: 16px; margin-left: 16px;">
                <ui:Button text="Return to Title" name="return"/>
                <ui:Button text="Quit to Desktop" name="quit"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
