<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameUI.uss?fileID=7433441132597879392&amp;guid=d47be867d797d924ea53d1bf24a6f2e0&amp;type=3#GameUI"/>
    <ui:VisualElement name="Screen" style="flex-grow: 1;"/>
    <ui:VisualElement name="DefenceLevel" style="position: absolute; height: 10%; width: 20%; top: 2.5%; left: 2%; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; flex-wrap: wrap; flex-direction: row; background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="Portrait" style="flex-grow: 1; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; background-image: url(&quot;project://database/Assets/Teachers/Principal/Principal-Portrait.png?fileID=2800000&amp;guid=242f7f57fa18c9a4993a99e9706036d2&amp;type=3#Principal-Portrait&quot;); width: 50%; height: 100%; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; -unity-text-auto-size: none;"/>
        <ui:VisualElement name="Principal-Info" style="flex-grow: 1; width: 50%; height: 100%;">
            <ui:Label text="Principal" style="color: rgb(0, 0, 0); -unity-font-style: bold; font-size: 40%; height: 50%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-auto-size: none;"/>
            <ui:ProgressBar value="50" title="hp-bar" name="ProgressBar" style="height: 50%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Dialogue" style="flex-grow: 1; position: absolute; top: 15%; left: 5%; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; background-color: rgb(255, 255, 255); width: 20%; height: 10%;">
        <ui:Label text="Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae pellentesque sem placerat. In id cursus mi pretium tellus duis convallis. Tempus leo eu aenean sed diam urna tempor. Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc" style="width: 100%; height: 100%; white-space: normal; text-overflow: clip; -unity-text-align: upper-left; position: relative;"/>
    </ui:VisualElement>
    <ui:VisualElement name="Teachers" style="flex-grow: 1; position: absolute; height: 15%; width: 100%; top: auto; left: 0%; bottom: 0%; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; right: auto; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; margin-top: 0; flex-direction: row; justify-content: center;">
        <ui:VisualElement name="Teacher1" class="Teacher" style="background-image: url(&quot;project://database/Assets/Teachers/PE/TeacherPE-Portrait.png?fileID=2800000&amp;guid=959646beea8d84b4e98414678fa4d484&amp;type=3#TeacherPE-Portrait&quot;); -unity-background-scale-mode: scale-and-crop; background-color: rgb(255, 0, 0);">
            <ui:Label text="PE Teacher" name="Teacher1Name" style="background-color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; -unity-text-align: upper-center; position: absolute; bottom: 0; left: 0;"/>
            <ui:Label text="$200" name="Teacher1Cost" style="background-color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; position: absolute; bottom: 0; white-space: nowrap; right: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Teacher2" class="Teacher"/>
        <ui:VisualElement name="Teacher3" class="Teacher"/>
        <ui:VisualElement name="Salary" class="Teacher" style="align-items: center; justify-content: space-around;">
            <ui:Label text="Salary: $123" name="Money" style="background-color: rgb(255, 255, 255); width: 75%; height: 75%; -unity-text-align: middle-center; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Waves" style="flex-grow: 1; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; position: absolute; height: 10%; width: 20%; top: 2.5%; left: auto; background-color: rgb(255, 255, 255); right: 2%;">
        <ui:Label text="Wave #1&#10;Enemies remaining: ?"/>
    </ui:VisualElement>
</ui:UXML>
