<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameUI.uss?fileID=7433441132597879392&amp;guid=d47be867d797d924ea53d1bf24a6f2e0&amp;type=3#GameUI"/>
    <ui:VisualElement name="Screen" style="flex-grow: 1;"/>
    <ui:VisualElement name="DefenceLevel" style="position: absolute; height: 10%; width: 20%; top: 2.5%; left: 2%; flex-wrap: wrap; flex-direction: row; background-color: rgb(232, 232, 232); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px;">
        <ui:VisualElement name="Portrait" style="flex-grow: 1; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; background-image: url(&quot;project://database/Assets/Teachers/Principal/Principal-Portrait.png?fileID=2800000&amp;guid=242f7f57fa18c9a4993a99e9706036d2&amp;type=3#Principal-Portrait&quot;); width: 50%; height: 100%; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; -unity-text-auto-size: none;"/>
        <ui:VisualElement name="Principal-Info" style="flex-grow: 1; width: 50%; height: 100%;">
            <ui:Label text="Principal" style="color: rgb(0, 0, 0); -unity-font-style: bold; font-size: 40%; height: 50%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-auto-size: none;"/>
            <ui:ProgressBar value="50" title="HP" name="HP" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: center; align-content: flex-start; height: 50%;">
                <Bindings>
                    <ui:DataBinding property="highValue" data-source-path="maxHp" data-source-type="Teacher, Assembly-CSharp" binding-mode="ToTarget"/>
                    <ui:DataBinding property="value" data-source-path="hp" data-source-type="Teacher, Assembly-CSharp" binding-mode="ToTarget"/>
                </Bindings>
            </ui:ProgressBar>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Dialogue" style="flex-grow: 1; position: absolute; top: 15%; left: 3%; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; background-color: rgb(232, 232, 232); width: 20%; height: 10%;">
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 100px; width: 100px; background-color: rgb(232, 232, 232); top: -14px; left: 25px; rotate: 45deg;"/>
        <ui:Label text="Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae pellentesque sem placerat. In id cursus mi pretium tellus duis convallis. Tempus leo eu aenean sed diam urna tempor. Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc" name="Label" style="width: 100%; height: 100%; white-space: normal; text-overflow: clip; -unity-text-align: upper-left; position: relative;"/>
    </ui:VisualElement>
    <ui:VisualElement name="Currency" style="position: absolute; left: 0; bottom: 20%; height: 50px; padding-left: 0; margin-left: 10px; margin-bottom: 10px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; flex-direction: row; width: 150px;">
        <ui:Label text="123" name="Money" style="background-color: rgb(232, 232, 232); width: 100px; position: absolute; height: 45px; top: 0; left: 70px; font-size: 24px; -unity-text-align: middle-right; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(43, 146, 40); border-right-color: rgb(43, 146, 40); border-top-color: rgb(43, 146, 40); border-bottom-color: rgb(43, 146, 40); -unity-font-style: bold;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="currency" data-source-type="GameManager, Assembly-CSharp" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:VisualElement style="flex-grow: 1; position: absolute; width: 55px; height: 55px; background-color: rgb(43, 146, 40); border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-right-radius: 50%; border-bottom-left-radius: 50%; top: -3px; left: 48px;"/>
        <ui:VisualElement name="" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/money-nobg.png?fileID=2800000&amp;guid=eaf934cd3d06dc44eb8818accd660297&amp;type=3#money-nobg&quot;); -unity-background-scale-mode: scale-to-fit;"/>
    </ui:VisualElement>
    <ui:VisualElement name="Teachers" style="flex-grow: 1; position: absolute; top: auto; left: 0%; bottom: 0%; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; right: auto; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; margin-top: 0; flex-direction: row; justify-content: flex-start; width: auto; height: 20%;">
        <ui:VisualElement name="Teacher1" class="Teacher">
            <ui:VisualElement name="Teacher1Portrait" class="TeacherPortrait" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Teachers/PE/TeacherPE-Portrait.png?fileID=2800000&amp;guid=959646beea8d84b4e98414678fa4d484&amp;type=3#TeacherPE-Portrait&quot;);"/>
            <ui:Label text="PE Teacher" name="Teacher1Name" class="TeacherName"/>
            <ui:Label text="$200" name="Teacher1Cost" class="TeacherCost"/>
        </ui:VisualElement>
        <ui:VisualElement name="Teacher2" class="Teacher"/>
        <ui:VisualElement name="Teacher3" class="Teacher"/>
    </ui:VisualElement>
    <ui:VisualElement name="Waves" style="border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; position: absolute; height: 10%; width: 10%; top: 2.5%; left: auto; background-color: rgb(232, 232, 232); right: 2%;">
        <ui:Label text="Wave #1&#10;Enemies remaining: ?" name="WaveInfo">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="currentWave" data-source-type="GameManager, Assembly-CSharp" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:VisualElement name="" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/wave%20info-nobg.png?fileID=2800000&amp;guid=454e253cdfcbb004facfa1803e7dc8a4&amp;type=3#wave info-nobg&quot;); -unity-background-scale-mode: scale-to-fit; position: absolute; height: 256px; width: 113px; top: 1px; left: 105px;"/>
    </ui:VisualElement>
</ui:UXML>
